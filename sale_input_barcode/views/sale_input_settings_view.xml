<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_res_config_settings_sale_input_barcode" model="ir.ui.view">
        <field name="name">res.config.settings.sale.input.barcode</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="no_edit_order" position="after">
                <setting
                    id="sale_barcode_update_existing_line"
                    help="Instead of creating a new sale order line it increases the quantity for each barcode scan"
                >
                    <field name="sale_barcode_update_existing_line" />
                </setting>
            </setting>
        </field>
    </record>
</odoo>
