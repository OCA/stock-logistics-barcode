<odoo>
    <record id="product_template_form_view_multi_barcode" model="ir.ui.view">
        <field name="name">product.template.form.multi.barcode</field>
        <field name="model">product.template</field>
        <field name="priority">16</field>
        <field
            name="inherit_id"
            ref="product_multi_barcode.product_template_form_view_multi_barcode"
        />
        <field name="arch" type="xml">
            <field name="barcode_ids" position="attributes">
                <attribute name="invisible" />
            </field>
            <xpath expr="//field[@name='barcode_ids']/list" position="inside">
                <field
                    name="product_id"
                    readonly="1"
                    invisible="product_variant_count == 1"
                />
                <field name="supplier_id" readonly="1" />
            </xpath>
            <xpath
                expr="//field[@name='barcode_ids']/list/field[@name='name']"
                position="attributes"
            >
                <attribute name="readonly">product_variant_count &gt; 1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
