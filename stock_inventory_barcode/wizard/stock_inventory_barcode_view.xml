<odoo>
    <record id="stock_inventory_barcode_form" model="ir.ui.view">
        <field name="name">stock.inventory.barcode.form</field>
        <field name="model">stock.inventory.barcode</field>
        <field name="arch" type="xml">
            <form string="Inventory Barcode Wizard">
                <group name="mode" string="Select Mode">
                    <group>
                        <field name="zero_count" />
                    </group>
                    <group>
                        <field name="auto_save" />
                    </group>
                    <field name="quant_id" invisible="1" force_save="1" />
                </group>
                <group name="product" string="Select Product">
                    <field name="inventory_id" invisible="1" />
                    <field name="multi_stock_location" invisible="1" />
                    <field name="company_id" invisible="1" />
                    <field name="product_code" autofocus="1" />
                    <field name="product_id" />
                    <field name="product_tracking" invisible="1" />
                    <field
                        name="lot_id"
                        invisible="product_tracking not in ('serial', 'lot')"
                        required="product_tracking in ('lot', 'serial')"
                        context="{'default_product_id': product_id}"
                    />
                    <field
                        name="location_id"
                        invisible="not multi_stock_location"
                        options="{'no_create': True, 'no_create_edit': True}"
                    />
                </group>
                <group name="qty" string="Update Quantity">
                    <group>
                        <label for="change_qty" invisible="zero_count" />
                        <div name="change_qty" invisible="zero_count" class="o_row">
                            <field name="change_qty" />
                            <field name="uom_name" groups="uom.group_uom" />
                        </div>
                        <label for="add_qty" invisible="not zero_count" />
                        <div name="add_qty" invisible="not zero_count" class="o_row">
                            <field name="add_qty" />
                            <field name="uom_name" groups="uom.group_uom" />
                        </div>
                    </group>
                    <group>
                        <label for="theoretical_qty" />
                        <div name="theoretical_qty" class="o_row">
                            <field name="theoretical_qty" />
                            <field name="uom_name" groups="uom.group_uom" />
                        </div>
                        <label for="product_qty" />
                        <div name="product_qty" class="o_row">
                            <field name="product_qty" />
                            <field name="uom_name" groups="uom.group_uom" />
                        </div>
                    </group>
                </group>
                <group
                    name="note"
                    string="Other inventory lines with the same product"
                    invisible="not note"
                >
                    <field name="note" nolabel="1" />
                </group>
                <footer>
                    <button
                        name="save"
                        type="object"
                        class="btn-primary"
                        string="Update"
                    />
                    <button special="cancel" string="Close" class="oe_link" />
                </footer>
            </form>
        </field>
    </record>

    <record id="stock_inventory_barcode_action" model="ir.actions.act_window">
        <field name="name">Inventory Barcode Wizard</field>
        <field name="res_model">stock.inventory.barcode</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
