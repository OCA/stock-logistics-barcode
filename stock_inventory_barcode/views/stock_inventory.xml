<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_inventory_form" model="ir.ui.view">
        <field name="name">stock.inventory.barcode.inventory.form</field>
        <field name="model">stock.inventory</field>
        <field name="inherit_id" ref="stock_inventory.view_inventory_group_form" />
        <field name="arch" type="xml">
            <button name="action_state_to_in_progress" position="after">
                <button
                    name="%(stock_inventory_barcode_action)d"
                    type="action"
                    string="Start Barcode Interface"
                    invisible="state != 'in_progress'"
                />
            </button>
        </field>
    </record>
</odoo>
