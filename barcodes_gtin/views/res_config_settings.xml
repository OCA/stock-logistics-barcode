<odoo>

    <record id="res_config_settings_form_view" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">

            <xpath expr="//div[@name='barcode_setting_container']" position="inside">

                <div id="gtin13_enforcement" class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="enforce_gtin_barcodes" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="enforce_gtin_barcodes" />
                        <span
                            class="fa fa-lg fa-building-o"
                            title="Values set here are company-specific."
                            groups="base.group_multi_company"
                        />
                        <div class="text-muted">
                            Force product barcodes to match strict GTIN formats.
                        </div>
                    </div>
                </div>

            </xpath>
        </field>
    </record>

</odoo>
