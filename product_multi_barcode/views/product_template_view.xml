<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_form_view_multi_barcode" model="ir.ui.view">
        <field name="name">product.template.form.multi.barcode</field>
        <field name="model">product.template</field>
        <field name="priority" eval="16" />
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <field name="barcode" position="attributes">
                <attribute name="readonly">True</attribute>
                <attribute
                    name="invisible"
                >product_variant_count &gt; 1 or (product_variant_count == 0 and valid_product_template_attribute_line_ids) or type in ['service', 'combo']</attribute>
            </field>
            <field name="barcode" position="after">
                <field invisible="product_variant_count > 1" name="barcode_ids">
                    <list editable="bottom">
                        <field name="sequence" widget="handle" />
                        <field name="name" />
                    </list>
                </field>
            </field>
        </field>
    </record>
</odoo>
