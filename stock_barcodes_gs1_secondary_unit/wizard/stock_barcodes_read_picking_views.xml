<odoo>
    <record id="view_stock_barcodes_read_form" model="ir.ui.view">
        <field name="model">wiz.stock.barcodes.read</field>
        <field name="inherit_id" ref="stock_barcodes.view_stock_barcodes_read_form" />
        <field name="arch" type="xml">
            <div name="total_qty_header" position="before">
                <div class="col text-center pe-0" groups="uom.group_uom">
                    <field name="product_tmpl_id" invisible="1" />
                    <field
                        name="secondary_uom_id"
                        options="{'no_open': True, 'no_create': True}"
                        domain="['|', ('product_id', '=', product_id),
                                    '&amp;', ('product_tmpl_id.product_variant_ids', 'in', [product_id]),
                                             ('product_id', '=', False)]"
                        required="product_id and secondary_uom_qty"
                        force_save="1"
                        placeholder="Secondary uom"
                    />
                </div>
                <div
                    class="col text-center"
                    invisible="context.get('hide_secondary_single_qty', True)"
                    groups="uom.group_uom"
                >
                    <div>
                        <field
                            name="product_uom_id"
                            domain="[('id', '=', product_uom_id)]"
                            options="{'no_open': True, 'no_create': True}"
                        />
                    </div>
                </div>
            </div>
            <xpath expr="//div[@name='total_qty_header']/div" position="before">
                <div groups="uom.group_uom">
                    <span invisible="not secondary_uom_id">
                        <field name="total_secondary_uom_qty_done" /> / <field
                        name="total_secondary_uom_qty"
                    /> <field
                        name="secondary_uom_id"
                        domain="['|', ('product_id', '=', product_id),
                                        '&amp;', ('product_tmpl_id.product_variant_ids', 'in', [product_id]),
                                                 ('product_id', '=', False)]"
                        force_save="1"
                        readonly="1"
                        options="{'no_open': True, 'no_create': True}"
                    />
                    </span>
                </div>
            </xpath>
            <div name="total_qty_field" position="before">
                <div
                    class="col text-center pe-0"
                    invisible="not secondary_uom_id"
                    groups="uom.group_uom"
                >
                    <field
                        name="secondary_uom_qty"
                        force_save="1"
                        widget="numeric_step"
                        options="{'auto_select': True}"
                        invisible="not secondary_uom_id"
                    />
                </div>
                <div
                    class="col text-center px-0"
                    invisible="context.get('hide_secondary_single_qty', True)"
                    groups="uom.group_uom"
                >
                    <field
                        name="secondary_single_qty"
                        force_save="1"
                        widget="numeric_step"
                        options="{'auto_select': True}"
                    />
                </div>
            </div>
        </field>
    </record>

    <record id="view_stock_barcodes_read_picking_form" model="ir.ui.view">
        <field name="model">wiz.stock.barcodes.read.picking</field>
        <field
            name="inherit_id"
            ref="stock_barcodes.view_stock_barcodes_read_picking_form"
        />
        <field name="arch" type="xml">
            <!-- Add secondary uom info to detailed operations -->
            <xpath
                expr="//field[@name='move_line_ids']/kanban/field[@name='qty_picked']"
                position="after"
            >
                <field name="secondary_uom_qty" />
                <field name="secondary_uom_id" />
            </xpath>
            <xpath
                expr="//field[@name='move_line_ids']/kanban//div[hasclass('oe_kanban_global_click')]"
                position="inside"
            >
                <t t-if="record.secondary_uom_id.raw_value">
                    <div class="row">
                        <div class="col-12 fst-italic text-success">
                            <strong>
                                <field name="secondary_uom_qty" />
                                <field name="secondary_uom_id" />
                            </strong>
                        </div>
                    </div>
                </t>
            </xpath>
        </field>
    </record>

    <!-- Add secondary uom info to pending moves kanban -->
    <record id="view_stock_barcodes_pending_moves_kanban" model="ir.ui.view">
        <field name="name">stock.barcodes.pending.moves.kanban.secondary.unit</field>
        <field name="model">wiz.stock.barcodes.read.todo</field>
        <field
            name="inherit_id"
            ref="stock_barcodes.view_stock_barcodes_pending_moves_kanban"
        />
        <field name="arch" type="xml">
            <xpath expr="//kanban/field[@name='qty_done']" position="after">
                <field name="secondary_uom_qty" />
                <field name="secondary_uom_id" />
            </xpath>
            <xpath
                expr="//div[hasclass('o_stock_barcodes_pending_operation_qty')]"
                position="inside"
            >
                <t t-if="record.secondary_uom_id.raw_value">
                    <span class="text-success ms-2">
                        (<field name="secondary_uom_qty" /> <field
                        name="secondary_uom_id"
                    />)
                    </span>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
