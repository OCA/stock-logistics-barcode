<odoo>

<record id="view_stock_barcodes_read_form" model="ir.ui.view">
    <field name="model">wiz.stock.barcodes.read</field>
    <field name="inherit_id" ref="stock_barcodes.view_stock_barcodes_read_form" />
    <field name="arch" type="xml">
        <field name="create_lot" position="after">
            <field name="product_use_expiry_date" invisible="1" />
        </field>
        <xpath expr="//field[@name='lot_name']/.." position="after">
            <div
                    name="expiry_date_block"
                    class="m-0"
                    colspan="2"
                    attrs="{'invisible': ['|', ('create_lot', '=', False), ('product_use_expiry_date', '=', False)]}"
                >
                <strong class="d-none d-sm-block">Expiry Date</strong>
                <span
                        class="fa fa-tags d-sm-none oe_span_small_icon"
                        title="Expiry Date"
                    />
                <field name="expiry_date" style="width:60%" class="h5" />
            </div>
        </xpath>
    </field>
</record>

</odoo>
