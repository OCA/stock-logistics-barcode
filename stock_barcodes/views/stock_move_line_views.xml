<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_move_line_operation_tree" model="ir.ui.view">
        <field name="model">stock.move.line</field>
        <field
            name="inherit_id"
            ref="stock_move_line_qty_picked.view_stock_move_line_operation_tree"
        />
        <field name="arch" type="xml">
            <field name="qty_picked" position="attributes">
                <attribute name="string">Quantity Picked</attribute>
                <attribute
                    name="readonly"
                >(state == 'done' and is_locked) or (package_level_id and parent.picking_type_entire_packs)</attribute>
                <attribute name="sum">Quantity picked</attribute>
                <attribute name="optional">show</attribute>
                <attribute
                    name="help"
                >Quantity actually prepared. If no line is picked, validation uses the usual quantities. Once picking has started, change this quantity in the detailed operations to adjust what will be transferred.</attribute>
            </field>
        </field>
    </record>
    <record id="view_stock_move_line_detailed_operation_tree" model="ir.ui.view">
        <field name="model">stock.move.line</field>
        <field
            name="inherit_id"
            ref="stock_move_line_qty_picked.view_stock_move_line_detailed_operation_tree"
        />
        <field name="arch" type="xml">
            <field name="qty_picked" position="attributes">
                <attribute name="string">Quantity Picked</attribute>
                <attribute
                    name="readonly"
                >state in ('done', 'cancel') and is_locked</attribute>
                <attribute name="optional">show</attribute>
                <attribute
                    name="help"
                >Quantity actually prepared. If no line is picked, validation uses the usual quantities. Once picking has started, change this quantity in the detailed operations to adjust what will be transferred.</attribute>
            </field>
        </field>
    </record>
    <record id="view_move_line_form_qty_picked" model="ir.ui.view">
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock_move_line_qty_picked.view_move_line_form" />
        <field name="arch" type="xml">
            <field name="qty_picked" position="attributes">
                <attribute name="string">Quantity Picked</attribute>
                <attribute
                    name="help"
                >Quantity actually prepared. If no line is picked, validation uses the usual quantities. Once picking has started, change this quantity in the detailed operations to adjust what will be transferred.</attribute>
            </field>
        </field>
    </record>
</odoo>
