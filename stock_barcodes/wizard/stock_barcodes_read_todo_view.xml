<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_barcodes_todo_kanban" model="ir.ui.view">
        <field name="name">stock.barcodes.todo.kanban</field>
        <field name="model">wiz.stock.barcodes.read.todo</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="picking_code" />
                <field name="location_id" />
                <field name="location_name" />
                <field name="location_dest_id" />
                <field name="location_dest_name" />
                <field name="product_id" />
                <field name="lot_id" />
                <field name="uom_id" />
                <field name="package_id" />
                <field name="result_package_id" />
                <field name="package_product_qty" />
                <field name="product_uom_qty" />
                <field name="qty_done" />
                <field name="line_ids" invisible="1" />
                <field name="state" />
                <field name="is_extra_line" />
                <field name="is_stock_move_line_origin" />
                <templates>
                    <t t-name="card">
                        <div
                            t-attf-class="oe_kanban_content "
                            t-attf-style="background-color: {{record.is_extra_line.raw_value == true and '#ffd683' or '#f0f9fb'}};"
                        >
                            <div class="row">
                                <div class="col">
                                    <span
                                        class="fa fa-map-marker"
                                        title="Location name"
                                    />
                                    <strong>
                                        <span invisible="picking_code != 'incoming'">
                                            <field name="location_dest_name" />
                                        </span>
                                        <span invisible="picking_code != 'internal'">
                                            <field name="location_name" /> ⇨ <field
                                            name="location_dest_name"
                                        />
                                        </span>
                                        <span invisible="picking_code != 'outgoing'">
                                            <field name="location_name" />
                                        </span>
                                    </strong>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col">
                                    <strong>
                                        <field name="product_id" />
                                    </strong>
                                </div>
                            </div>
                            <t
                                t-if="record.lot_id or record.package_id or record.result_package_id"
                            >
                                <table>
                                    <tr>
                                        <td>
                                            <span>
                                                <span
                                                    class="fa fa-tags"
                                                    title="Lot S/N"
                                                />
                                                <field
                                                    name="lot_id"
                                                    options="{'no_open': True}"
                                                />
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <span class="fa fa-dropbox" />
                                            <span>
                                                <field name="package_id" />
                                                <t t-if="record.package_id">(<span
                                                    t-out="record.package_product_qty.value"
                                                /> <t
                                                    t-out="record.uom_id.value.slice(0,3)"
                                                />)</t>
                                            </span>
                                            <span>
                                                <field name="result_package_id" />
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </t>
                            <div class="row">
                                <div class="col-12">
                                    <span>
                                        <span class="fw-bold">
                                        <t t-out="record.qty_done.value" />
                                    </span> /
                                        <t
                                        t-if="record.is_stock_move_line_origin.raw_value"
                                    >
                                        <field name="product_qty_reserved" />
                                    </t>
                                        <t t-else="">
                                        <field name="product_uom_qty" />
                                    </t>
                                        <field name="uom_id" />
                                    </span>
                                    <strong
                                        class="bg-danger"
                                        t-if="record.is_extra_line.raw_value == true"
                                    >NOT AVAILABLE</strong>
                                </div>
                            </div>
                            <div name="action" class="row">
                                <div class="col-2">
                                    <button
                                        name="action_back_line"
                                        type="object"
                                        icon="fa-step-backward"
                                        title="Previous"
                                        class="btn-sm float-start btn btn-primary"
                                        context="{'wiz_barcode_id': parent.id}"
                                        data-hotkey="1"
                                    />
                                </div>
                                <div class="col-4 p-0">
                                    <button
                                        name="action_reset_lines"
                                        type="object"
                                        icon="fa-trash"
                                        title="Clean"
                                        class="btn-sm btn mx-auto d-block btn-warning"
                                        context="{'wiz_barcode_id': parent.id}"
                                        data-hotkey="2"
                                    />
                                </div>
                                <div class="col-4 p-0">
                                    <button
                                        name="action_todo_next"
                                        type="object"
                                        class="btn-sm mx-auto d-block btn-danger btn"
                                        context="{'wiz_barcode_id': parent.id}"
                                        data-hotkey="3"
                                        invisible="qty_done == 0.0 or is_extra_line or not is_stock_move_line_origin"
                                    >
                                    Ignore rest
                                    </button>
                                    <!-- Ask for confirmation when we've got done quantities to avoid squashing quantities -->
                                    <button
                                        name="action_todo_next"
                                        type="object"
                                        class="btn-sm mx-auto d-block btn-danger btn"
                                        context="{'wiz_barcode_id': parent.id}"
                                        data-hotkey="3"
                                        invisible="qty_done != 0.0 or is_extra_line or not is_stock_move_line_origin"
                                        confirm="You have not set any quantity to this operation and it will be removed from pending moves. Are you sure?"
                                    >Ignore rest
                                    </button>
                                </div>
                                <div class="col-2">
                                    <button
                                        name="action_next_line"
                                        type="object"
                                        icon="fa-step-forward"
                                        title="Next"
                                        class="btn-sm float-end btn btn-primary"
                                        context="{'wiz_barcode_id': parent.id}"
                                        data-hotkey="4"
                                    />
                                </div>
                            </div>
                            <div name="action_extra" class="row mt-2">
                                <div
                                    class="col-12 d-flex justify-content-between align-items-center"
                                >
                                    <button
                                        name="action_todo_next"
                                        type="object"
                                        class="btn btn-warning btn-sm"
                                        context="{'wiz_barcode_id': parent.id, 'barcode_backorder_action': 'pending'}"
                                        data-hotkey="3"
                                        invisible="not is_extra_line and is_stock_move_line_origin"
                                        confirm="This move will be set to pending. Are you sure?"
                                        style="max-width: 30%"
                                    >
                                    Restore to pending
                                    </button>
                                    <button
                                        name="action_todo_next"
                                        type="object"
                                        class="btn btn-danger btn-sm"
                                        context="{'wiz_barcode_id': parent.id, 'barcode_backorder_action': 'skip_backorder'}"
                                        data-hotkey="3"
                                        invisible="not is_extra_line and is_stock_move_line_origin"
                                        confirm="Odoo will not create a backorder for this move. Are you sure?"
                                        style="max-width: 30%"
                                    >
                                    No Backorder
                                    </button>
                                    <button
                                        name="action_todo_next"
                                        type="object"
                                        class="btn btn-primary btn-sm"
                                        context="{'wiz_barcode_id': parent.id, 'barcode_backorder_action': 'create_backorder'}"
                                        data-hotkey="3"
                                        invisible="not is_extra_line and is_stock_move_line_origin"
                                        style="max-width: 30%"
                                    >
                                    Create Backorder
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_stock_barcodes_pending_moves_kanban" model="ir.ui.view">
        <field name="name">stock.barcodes.todo.kanban</field>
        <field name="model">wiz.stock.barcodes.read.todo</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="id" />
                <field name="state" />
                <field name="product_id" />
                <field name="product_uom_qty" />
                <field name="qty_done" />
                <field name="qty_done_rest" />
                <field name="uom_id" />
                <field name="product_qty_reserved" />
                <field name="picking_state" />
                <field name="is_stock_move_line_origin" />
                <field name="location_id" />
                <field name="lot_id" />
                <field name="package_id" />
                <field name="result_package_id" />
                <field name="show_location_dest" />
                <field name="location_dest_name" />
                <templates>
                    <t t-name="card">
                        <div
                            class="oe_kanban_global_click o_stock_barcodes_pending_operation_card"
                        >
                            <div class="o_stock_barcodes_pending_operation_body">
                                <field
                                    name="product_id"
                                    class="o_stock_barcodes_pending_operation_product"
                                />
                                <t t-if="record.is_stock_move_line_origin.raw_value">
                                    <div
                                        class="o_stock_barcodes_pending_operation_meta"
                                    >
                                        <span
                                            class="fa fa-map-marker me-1"
                                            title="Location"
                                        />
                                        <field name="location_id" />
                                        <t t-if="record.lot_id.raw_value">
                                            <span class="ms-1">Lot:</span>
                                            <field name="lot_id" />
                                        </t>
                                    </div>
                                    <t
                                        t-if="record.show_location_dest.raw_value or record.package_id.raw_value or record.result_package_id.raw_value"
                                    >
                                        <div
                                            class="o_stock_barcodes_pending_operation_meta"
                                        >
                                            <t
                                                t-if="record.show_location_dest.raw_value"
                                            >
                                                <span
                                                    class="fa fa-arrow-right me-1"
                                                    title="Destination"
                                                />
                                                <field name="location_dest_name" />
                                            </t>
                                            <t
                                                t-if="record.package_id.raw_value or record.result_package_id.raw_value"
                                            >
                                                <span
                                                    class="fa fa-dropbox ms-1 me-1"
                                                    title="Package"
                                                />
                                                <field name="package_id" />
                                                <t
                                                    t-if="record.result_package_id.raw_value"
                                                >
                                                    --> <field
                                                    name="result_package_id"
                                                />
                                                </t>
                                            </t>
                                        </div>
                                    </t>
                                </t>
                                <div class="o_stock_barcodes_pending_operation_qty">
                                    <field name="qty_done" />
                                    &#32;/&#32;
                                    <t
                                    t-if="record.is_stock_move_line_origin.raw_value"
                                >
                                    <field name="product_qty_reserved" />
                                </t>
                                    <t t-else="">
                                    <field name="product_uom_qty" />
                                </t>
                                    <span
                                    t-if="record.uom_id"
                                    t-out="record.uom_id.value"
                                />
                                </div>
                            </div>
                            <div class="o_stock_barcodes_pending_operation_actions">
                                <button
                                    name="action_reset_lines"
                                    type="object"
                                    class="btn btn-op-big btn-warning o_stock_barcodes_pending_operation_button"
                                    context="{'wiz_barcode_id': parent.id}"
                                    t-if="record.qty_done.raw_value &gt; 0"
                                    title="Clean scanned quantity"
                                >
                                    <i
                                        class="fa fa-trash"
                                        title="Clean scanned quantity"
                                    />
                                </button>
                                <button
                                    name="action_barcode_inventory_quant_edit"
                                    type="object"
                                    class="btn btn-op-big btn-outline-secondary o_stock_barcodes_pending_operation_button"
                                    context="{'wiz_barcode_id': parent.id}"
                                >
                                    <i
                                        class="fa fa-pencil"
                                        title="Edit inventory quantity"
                                    />
                                </button>
                                <button
                                    name="operation_quantities"
                                    type="object"
                                    class="btn btn-lg btn-primary btn-op-big o_stock_barcodes_pending_operation_button o_stock_barcodes_pending_operation_todo"
                                    t-if="record.qty_done_rest.raw_value > 0"
                                >
                                    +
                                    <span
                                    class="text-white"
                                    t-out="record.qty_done_rest.raw_value"
                                />
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
