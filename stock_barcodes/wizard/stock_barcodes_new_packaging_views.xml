<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_barcodes_new_packaging" model="ir.ui.view">
        <field name="name">stock.barcodes.new.packaging.form</field>
        <field name="model">wiz.stock.barcodes.new.packaging</field>
        <field name="arch" type="xml">
            <form>
                <field
                    name="_barcode_scanned"
                    widget="barcode_handler"
                    invisible="0"
                    no_label="1"
                />
                <sheet>
                    <div class="alert alert-info text-center" role="alert">
                        <p>1 - Select product</p>
                        <p>2 - Scan or input product packaging barcode</p>
                    </div>
                    <group>
                        <field name="product_id" />
                        <field name="barcode" />
                        <field name="name" />
                    </group>
                    <div>
                        <button
                            string="Confirm"
                            name="confirm"
                            type="object"
                            class="btn-primary oe_kanban_action_button"
                        />
                        <button
                            string="Cancel"
                            name="cancel"
                            class="btn-default oe_kanban_action_button"
                            type="object"
                        />
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_stock_barcodes_new_packaging" model="ir.actions.act_window">
        <field name="res_model">wiz.stock.barcodes.new.packaging</field>
        <field name="name">New Packaging</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="view_id" ref="view_stock_barcodes_new_packaging" />
        <field name="target">inline</field>
    </record>
</odoo>
