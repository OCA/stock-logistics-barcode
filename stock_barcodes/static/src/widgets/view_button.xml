<templates xml:space="preserve">
    <t t-inherit="web.ViewButton" t-inherit-mode="extension">
        <xpath expr="//button" position="attributes">
            <attribute name="t-att-accesskey">props['accesskey']</attribute>
            <attribute name="t-att-data-hotkey">props['data-hotkey']</attribute>
        </xpath>
    </t>
</templates>
